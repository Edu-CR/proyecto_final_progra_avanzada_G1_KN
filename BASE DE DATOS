--CREACION DE LA BASE DE DATOS
IF DB_ID(N'BioquimiaDB') IS NULL
    CREATE DATABASE [BioquimiaDB];
GO

USE [BioquimiaDB];
GO


/* =====================================================================
   1. CATÁLOGOS Y SEGURIDAD
   ===================================================================== */

-- Perfiles del sistema (RF-05).
CREATE TABLE [dbo].[TB_Rol](
    [IdRol]     [int] IDENTITY(1,1) NOT NULL,
    [NombreRol] [varchar](100) NOT NULL,
    CONSTRAINT [PK_TB_Rol] PRIMARY KEY CLUSTERED ([IdRol] ASC),
    CONSTRAINT [UQ_TB_Rol_NombreRol] UNIQUE ([NombreRol])
);
GO

-- Estados del prototipo 
CREATE TABLE [dbo].[TB_EstadoPrototipo](
    [IdEstadoPrototipo] [int] IDENTITY(1,1) NOT NULL,
    [NombreEstado]      [varchar](50) NOT NULL,
    CONSTRAINT [PK_TB_EstadoPrototipo] PRIMARY KEY CLUSTERED ([IdEstadoPrototipo] ASC),
    CONSTRAINT [UQ_TB_EstadoPrototipo_NombreEstado] UNIQUE ([NombreEstado])
);
GO


-- Categorías de producto (limpiadores, desinfectantes, jabones, etc.)
CREATE TABLE [dbo].[TB_Categoria](
    [IdCategoria]     [int] IDENTITY(1,1) NOT NULL,
    [NombreCategoria] [nvarchar](100) NOT NULL,
    [Estado]          [bit] NOT NULL CONSTRAINT [DF_TB_Categoria_Estado] DEFAULT (1),
    CONSTRAINT [PK_TB_Categoria] PRIMARY KEY CLUSTERED ([IdCategoria] ASC),
    CONSTRAINT [UQ_TB_Categoria_NombreCategoria] UNIQUE ([NombreCategoria])
);
GO

-- Usuarios (RF-01 a RF-06, RNF-18). 
-- Contrasenna se guarda sin hash (nvarchar(15)): la validación del sistema
-- debe exigir entre 8 y 15 caracteres.
CREATE TABLE [dbo].[TB_Usuario](
    [IdUsuario]         [int] IDENTITY(1,1) NOT NULL,
    [Identificacion]    [nvarchar](20)  NOT NULL,
    [NombreCompleto]    [nvarchar](250) NOT NULL,
    [CorreoElectronico] [nvarchar](100) NOT NULL,
    [Contrasenna]       [nvarchar](15)  NOT NULL,
    [Estado]            [bit] NOT NULL CONSTRAINT [DF_TB_Usuario_Estado] DEFAULT (1),
    [IdRol]             [int] NOT NULL,
    [FechaCreacion]     [datetime] NOT NULL CONSTRAINT [DF_TB_Usuario_FechaCreacion] DEFAULT (GETDATE()),
    CONSTRAINT [PK_TB_Usuario] PRIMARY KEY CLUSTERED ([IdUsuario] ASC),
    CONSTRAINT [UQ_TB_Usuario_CorreoElectronico] UNIQUE ([CorreoElectronico]),
    CONSTRAINT [UQ_TB_Usuario_Identificacion] UNIQUE ([Identificacion]),
    CONSTRAINT [FK_TB_Usuario_TB_Rol] FOREIGN KEY ([IdRol]) REFERENCES [dbo].[TB_Rol]([IdRol])
);
GO

-- Códigos de 6 dígitos de un solo uso para recuperar la contraseña (RF-04). Vencen a los 30 minutos.
-- Token NO es único (dos usuarios podrían recibir el mismo código): se valida por usuario.
-- Intentos cuenta los códigos incorrectos; después de 5 el código se bloquea.
CREATE TABLE [dbo].[TB_TokenRecuperacion](
    [IdTokenRecuperacion] [int] IDENTITY(1,1) NOT NULL,
    [IdUsuario]           [int] NOT NULL,
    [Token]               [nvarchar](10)  NOT NULL,
    [FechaCreacion]       [datetime] NOT NULL CONSTRAINT [DF_TB_TokenRecuperacion_FechaCreacion] DEFAULT (GETDATE()),
    [FechaVencimiento]    [datetime] NOT NULL,
    [Usado]               [bit] NOT NULL CONSTRAINT [DF_TB_TokenRecuperacion_Usado] DEFAULT (0),
    [Intentos]            [int] NOT NULL CONSTRAINT [DF_TB_TokenRecuperacion_Intentos] DEFAULT (0),
    CONSTRAINT [PK_TB_TokenRecuperacion] PRIMARY KEY CLUSTERED ([IdTokenRecuperacion] ASC),
    CONSTRAINT [FK_TB_TokenRecuperacion_TB_Usuario] FOREIGN KEY ([IdUsuario]) REFERENCES [dbo].[TB_Usuario]([IdUsuario]),
    CONSTRAINT [CK_TB_TokenRecuperacion_Fechas] CHECK ([FechaVencimiento] > [FechaCreacion])
);
GO

-- Bitácora de errores del sistema (RNF-17). IdUsuario es opcional
-- porque un error puede ocurrir sin sesión iniciada.
CREATE TABLE [dbo].[TB_BitacoraError](
    [IdBitacoraError] [int] IDENTITY(1,1) NOT NULL,
    [FechaError]      [datetime] NOT NULL CONSTRAINT [DF_TB_BitacoraError_FechaError] DEFAULT (GETDATE()),
    [Modulo]          [nvarchar](100) NOT NULL,
    [Mensaje]         [nvarchar](1000) NOT NULL,
    [Detalle]         [nvarchar](max) NULL,
    [IdUsuario]       [int] NULL,
    CONSTRAINT [PK_TB_BitacoraError] PRIMARY KEY CLUSTERED ([IdBitacoraError] ASC),
    CONSTRAINT [FK_TB_BitacoraError_TB_Usuario] FOREIGN KEY ([IdUsuario]) REFERENCES [dbo].[TB_Usuario]([IdUsuario])
);
GO

/* =====================================================================
   2. EMPRESAS E INGREDIENTES
   ===================================================================== */

-- Empresas que hacen negocios con Bioquimia (RF-14). Eliminación lógica con Estado.
CREATE TABLE [dbo].[TB_Empresa](
    [IdEmpresa]         [int] IDENTITY(1,1) NOT NULL,
    [NombreEmpresa]     [nvarchar](150) NOT NULL,
    [Contacto]          [nvarchar](150) NULL,
    [Telefono]          [nvarchar](20)  NULL,
    [CorreoElectronico] [nvarchar](100) NULL,
    [Estado]            [bit] NOT NULL CONSTRAINT [DF_TB_Empresa_Estado] DEFAULT (1),
    [FechaCreacion]     [datetime] NOT NULL CONSTRAINT [DF_TB_Empresa_FechaCreacion] DEFAULT (GETDATE()),
    CONSTRAINT [PK_TB_Empresa] PRIMARY KEY CLUSTERED ([IdEmpresa] ASC),
    CONSTRAINT [UQ_TB_Empresa_NombreEmpresa] UNIQUE ([NombreEmpresa])
);
GO

-- Catálogo de ingredientes (RF-23).
CREATE TABLE [dbo].[TB_Ingrediente](
    [IdIngrediente]     [int] IDENTITY(1,1) NOT NULL,
    [NombreIngrediente] [nvarchar](100) NOT NULL,
    [Funcion]           [nvarchar](50)  NOT NULL,
    [UnidadBase]        [varchar](10)   NOT NULL,
    [Estado]            [bit] NOT NULL CONSTRAINT [DF_TB_Ingrediente_Estado] DEFAULT (1),
    CONSTRAINT [PK_TB_Ingrediente] PRIMARY KEY CLUSTERED ([IdIngrediente] ASC),
    CONSTRAINT [UQ_TB_Ingrediente_NombreIngrediente] UNIQUE ([NombreIngrediente]),
    CONSTRAINT [CK_TB_Ingrediente_UnidadBase] CHECK ([UnidadBase] IN ('kg', 'litro'))
);
GO

/* =====================================================================
   3. PROTOTIPOS Y FLUJO DE ESTADOS
   ===================================================================== */

-- Prototipo (RF-07 a RF-13). IdQuimico apunta al IdUsuario del químico creador.
-- ComentarioGerente guarda la última justificación del gerente (para "En trámite").
-- El detalle de todos los cambios queda en TB_HistorialEstado.
-- ImagenRuta guarda la ruta del archivo de la imagen principal (por ejemplo ~/Content/Imagenes/12.jpg).
CREATE TABLE [dbo].[TB_Prototipo](
    [IdPrototipo]           [int] IDENTITY(1,1) NOT NULL,
    [NombrePrototipo]       [nvarchar](150)  NOT NULL,
    [IdCategoria]           [int] NOT NULL,
    [Descripcion]           [nvarchar](1000) NOT NULL,
    [CaracteristicasEnvase] [nvarchar](500)  NOT NULL,
    [ImagenRuta]            [nvarchar](260)  NOT NULL,
    [IdQuimico]             [int] NOT NULL,
    [IdEstadoPrototipo]     [int] NOT NULL CONSTRAINT [DF_TB_Prototipo_IdEstadoPrototipo] DEFAULT (1),
    [ComentarioGerente]     [nvarchar](500)  NULL,
    [FechaCreacion]         [datetime] NOT NULL CONSTRAINT [DF_TB_Prototipo_FechaCreacion] DEFAULT (GETDATE()),
    [FechaModificacion]     [datetime] NULL,
    CONSTRAINT [PK_TB_Prototipo] PRIMARY KEY CLUSTERED ([IdPrototipo] ASC),
    CONSTRAINT [UQ_TB_Prototipo_Quimico_Nombre] UNIQUE ([IdQuimico], [NombrePrototipo]),
    CONSTRAINT [FK_TB_Prototipo_TB_Categoria] FOREIGN KEY ([IdCategoria]) REFERENCES [dbo].[TB_Categoria]([IdCategoria]),
    CONSTRAINT [FK_TB_Prototipo_TB_Usuario] FOREIGN KEY ([IdQuimico]) REFERENCES [dbo].[TB_Usuario]([IdUsuario]),
    CONSTRAINT [FK_TB_Prototipo_TB_EstadoPrototipo] FOREIGN KEY ([IdEstadoPrototipo]) REFERENCES [dbo].[TB_EstadoPrototipo]([IdEstadoPrototipo])
);
GO

-- Fórmula del prototipo: ingredientes con su porcentaje (RF-07).
-- La suma de porcentajes = 100 se valida en la aplicación.
CREATE TABLE [dbo].[TB_PrototipoIngrediente](
    [IdPrototipo]   [int] NOT NULL,
    [IdIngrediente] [int] NOT NULL,
    [Porcentaje]    [decimal](5,2) NOT NULL,
    CONSTRAINT [PK_TB_PrototipoIngrediente] PRIMARY KEY CLUSTERED ([IdPrototipo] ASC, [IdIngrediente] ASC),
    CONSTRAINT [FK_TB_PrototipoIngrediente_TB_Prototipo] FOREIGN KEY ([IdPrototipo]) REFERENCES [dbo].[TB_Prototipo]([IdPrototipo]),
    CONSTRAINT [FK_TB_PrototipoIngrediente_TB_Ingrediente] FOREIGN KEY ([IdIngrediente]) REFERENCES [dbo].[TB_Ingrediente]([IdIngrediente]),
    CONSTRAINT [CK_TB_PrototipoIngrediente_Porcentaje] CHECK ([Porcentaje] > 0 AND [Porcentaje] <= 100)
);
GO

-- Relación muchos a muchos entre prototipos y empresas (RF-15).
CREATE TABLE [dbo].[TB_PrototipoEmpresa](
    [IdPrototipo] [int] NOT NULL,
    [IdEmpresa]   [int] NOT NULL,
    CONSTRAINT [PK_TB_PrototipoEmpresa] PRIMARY KEY CLUSTERED ([IdPrototipo] ASC, [IdEmpresa] ASC),
    CONSTRAINT [FK_TB_PrototipoEmpresa_TB_Prototipo] FOREIGN KEY ([IdPrototipo]) REFERENCES [dbo].[TB_Prototipo]([IdPrototipo]),
    CONSTRAINT [FK_TB_PrototipoEmpresa_TB_Empresa] FOREIGN KEY ([IdEmpresa]) REFERENCES [dbo].[TB_Empresa]([IdEmpresa])
);
GO

-- Historial de cambios de estado: quién, cuándo, de qué estado a cuál y por qué.
-- IdEstadoAnterior es NULL cuando el prototipo se crea.
-- Nota EF: IdEstadoAnterior e IdEstadoNuevo requieren [ForeignKey] porque
-- no se llaman igual que la llave primaria.
CREATE TABLE [dbo].[TB_HistorialEstado](
    [IdHistorialEstado] [int] IDENTITY(1,1) NOT NULL,
    [IdPrototipo]       [int] NOT NULL,
    [IdEstadoAnterior]  [int] NULL,
    [IdEstadoNuevo]     [int] NOT NULL,
    [IdUsuario]         [int] NOT NULL,
    [Justificacion]     [nvarchar](500) NULL,
    [FechaCambio]       [datetime] NOT NULL CONSTRAINT [DF_TB_HistorialEstado_FechaCambio] DEFAULT (GETDATE()),
    CONSTRAINT [PK_TB_HistorialEstado] PRIMARY KEY CLUSTERED ([IdHistorialEstado] ASC),
    CONSTRAINT [FK_TB_HistorialEstado_TB_Prototipo] FOREIGN KEY ([IdPrototipo]) REFERENCES [dbo].[TB_Prototipo]([IdPrototipo]),
    CONSTRAINT [FK_TB_HistorialEstado_TB_EstadoPrototipo_Anterior] FOREIGN KEY ([IdEstadoAnterior]) REFERENCES [dbo].[TB_EstadoPrototipo]([IdEstadoPrototipo]),
    CONSTRAINT [FK_TB_HistorialEstado_TB_EstadoPrototipo_Nuevo] FOREIGN KEY ([IdEstadoNuevo]) REFERENCES [dbo].[TB_EstadoPrototipo]([IdEstadoPrototipo]),
    CONSTRAINT [FK_TB_HistorialEstado_TB_Usuario] FOREIGN KEY ([IdUsuario]) REFERENCES [dbo].[TB_Usuario]([IdUsuario])
);
GO

/* =====================================================================
   4. PRUEBAS DE LABORATORIO (RF-19 a RF-22)
   ===================================================================== */

-- Tipos de prueba con su rango permitido. Obligatoria = bloquea el envío (RF-21).
CREATE TABLE [dbo].[TB_TipoPrueba](
    [IdTipoPrueba]     [int] IDENTITY(1,1) NOT NULL,
    [NombreTipoPrueba] [nvarchar](100) NOT NULL,
    [Unidad]           [nvarchar](20)  NOT NULL,
    [ValorMinimo]      [decimal](10,2) NOT NULL,
    [ValorMaximo]      [decimal](10,2) NOT NULL,
    [Obligatoria]      [bit] NOT NULL CONSTRAINT [DF_TB_TipoPrueba_Obligatoria] DEFAULT (0),
    [Estado]           [bit] NOT NULL CONSTRAINT [DF_TB_TipoPrueba_Estado] DEFAULT (1),
    CONSTRAINT [PK_TB_TipoPrueba] PRIMARY KEY CLUSTERED ([IdTipoPrueba] ASC),
    CONSTRAINT [UQ_TB_TipoPrueba_NombreTipoPrueba] UNIQUE ([NombreTipoPrueba]),
    CONSTRAINT [CK_TB_TipoPrueba_Rango] CHECK ([ValorMinimo] <= [ValorMaximo])
);
GO

-- Resultados de pruebas por prototipo. Resultado lo calcula el sistema según el rango.
-- Cada nuevo intento es una fila nueva; el último por tipo de prueba es el vigente.
CREATE TABLE [dbo].[TB_PruebaPrototipo](
    [IdPruebaPrototipo] [int] IDENTITY(1,1) NOT NULL,
    [IdPrototipo]       [int] NOT NULL,
    [IdTipoPrueba]      [int] NOT NULL,
    [ValorMedido]       [decimal](10,2) NOT NULL,
    [Resultado]         [varchar](10) NOT NULL,
    [FechaPrueba]       [date] NOT NULL,
    [Observaciones]     [nvarchar](300) NULL,
    [IdUsuario]         [int] NOT NULL,
    [FechaRegistro]     [datetime] NOT NULL CONSTRAINT [DF_TB_PruebaPrototipo_FechaRegistro] DEFAULT (GETDATE()),
    CONSTRAINT [PK_TB_PruebaPrototipo] PRIMARY KEY CLUSTERED ([IdPruebaPrototipo] ASC),
    CONSTRAINT [FK_TB_PruebaPrototipo_TB_Prototipo] FOREIGN KEY ([IdPrototipo]) REFERENCES [dbo].[TB_Prototipo]([IdPrototipo]),
    CONSTRAINT [FK_TB_PruebaPrototipo_TB_TipoPrueba] FOREIGN KEY ([IdTipoPrueba]) REFERENCES [dbo].[TB_TipoPrueba]([IdTipoPrueba]),
    CONSTRAINT [FK_TB_PruebaPrototipo_TB_Usuario] FOREIGN KEY ([IdUsuario]) REFERENCES [dbo].[TB_Usuario]([IdUsuario]),
    CONSTRAINT [CK_TB_PruebaPrototipo_Resultado] CHECK ([Resultado] IN ('Aprobada', 'Reprobada'))
);
GO

/* =====================================================================
   5. CUMPLIMIENTO REGULATORIO (RF-24 a RF-27)
   ===================================================================== */

-- Un registro regulatorio por prototipo. Todo se guarda como datos (sin archivos).
-- El estado Vigente / Por vencer / Vencido se calcula en la aplicación con FechaVencimiento.
-- FechaAlertaEnviada evita repetir el correo de alerta (RF-25).
CREATE TABLE [dbo].[TB_RegistroRegulatorio](
    [IdRegistroRegulatorio]  [int] IDENTITY(1,1) NOT NULL,
    [IdPrototipo]            [int] NOT NULL,
    [NumeroRegistro]         [nvarchar](50) NOT NULL,
    [FechaEmision]           [date] NOT NULL,
    [FechaVencimiento]       [date] NOT NULL,
    [FechaAlertaEnviada]     [datetime] NULL,
    -- Checklist de etiquetado obligatorio
    [EtiquetaNombreProducto] [bit] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_EtiquetaNombreProducto] DEFAULT (0),
    [EtiquetaIngredientes]   [bit] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_EtiquetaIngredientes] DEFAULT (0),
    [EtiquetaAdvertencias]   [bit] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_EtiquetaAdvertencias] DEFAULT (0),
    [EtiquetaInstrucciones]  [bit] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_EtiquetaInstrucciones] DEFAULT (0),
    [EtiquetaContenidoNeto]  [bit] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_EtiquetaContenidoNeto] DEFAULT (0),
    [EtiquetaLote]           [bit] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_EtiquetaLote] DEFAULT (0),
    [EtiquetaFabricante]     [bit] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_EtiquetaFabricante] DEFAULT (0),
    [EtiquetaFechaVencimiento] [bit] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_EtiquetaFechaVencimiento] DEFAULT (0),
    -- Hoja de seguridad (SDS) como campos
    [SdsPeligros]            [nvarchar](500) NULL,
    [SdsPrimerosAuxilios]    [nvarchar](500) NULL,
    [SdsAlmacenamiento]      [nvarchar](500) NULL,
    [SdsFechaRevision]       [date] NULL,
    [FechaRegistro]          [datetime] NOT NULL CONSTRAINT [DF_TB_RegistroRegulatorio_FechaRegistro] DEFAULT (GETDATE()),
    CONSTRAINT [PK_TB_RegistroRegulatorio] PRIMARY KEY CLUSTERED ([IdRegistroRegulatorio] ASC),
    CONSTRAINT [UQ_TB_RegistroRegulatorio_IdPrototipo] UNIQUE ([IdPrototipo]),
    CONSTRAINT [UQ_TB_RegistroRegulatorio_NumeroRegistro] UNIQUE ([NumeroRegistro]),
    CONSTRAINT [FK_TB_RegistroRegulatorio_TB_Prototipo] FOREIGN KEY ([IdPrototipo]) REFERENCES [dbo].[TB_Prototipo]([IdPrototipo]),
    CONSTRAINT [CK_TB_RegistroRegulatorio_Fechas] CHECK ([FechaVencimiento] > [FechaEmision])
);
GO

-- Control de la revisión diaria de vencimientos (RF-25): una sola fila.
CREATE TABLE [dbo].[TB_ControlAlertas](
    [IdControlAlertas] [int] IDENTITY(1,1) NOT NULL,
    [UltimaRevision]   [date] NOT NULL,
    CONSTRAINT [PK_TB_ControlAlertas] PRIMARY KEY CLUSTERED ([IdControlAlertas] ASC)
);
GO

