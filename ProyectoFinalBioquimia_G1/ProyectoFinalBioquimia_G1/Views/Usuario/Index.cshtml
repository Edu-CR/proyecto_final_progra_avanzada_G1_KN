@model IEnumerable<ProyectoFinalBioquimia_G1.EF.TB_Usuario>

@{
    ViewBag.Title = "Usuarios del sistema";
    int idActual = Convert.ToInt32(Session["IdUsuarioSession"]);
    string filtroActual = ViewBag.Filtro as string ?? "activos";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Usuarios del sistema</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <!-- Búsqueda y filtro -->
                    <form action="@Url.Action("Index", "Usuario")" method="get" class="d-flex flex-wrap gap-2">
                        <input type="text" name="buscar" value="@ViewBag.Buscar"
                               class="form-control" style="width: 260px;"
                               placeholder="Buscar por nombre, código o correo" />

                        <select name="filtro" class="form-select" style="width: 150px;">
                            <option value="activos" @(filtroActual == "activos" ? "selected" : "")>Activos</option>
                            <option value="inactivos" @(filtroActual == "inactivos" ? "selected" : "")>Inactivos</option>
                            <option value="todos" @(filtroActual == "todos" ? "selected" : "")>Todos</option>
                        </select>

                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-search"></i> Buscar
                        </button>

                        <a href="@Url.Action("Index", "Usuario")" class="btn btn-outline-secondary">
                            Limpiar
                        </a>
                    </form>

                    <!-- Nuevo usuario -->
                    <a href="@Url.Action("Crear", "Usuario")" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Nuevo usuario
                    </a>
                </div>
            </div>

            <div class="card-body table-responsive p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre completo</th>
                            <th>Correo electrónico</th>
                            <th>Rol</th>
                            <th>Creado</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No se encontraron usuarios.
                                </td>
                            </tr>
                        }

                        @foreach (var u in Model)
                        {
                            <tr>
                                <td>@u.Identificacion</td>
                                <td>@u.NombreCompleto</td>
                                <td>@u.CorreoElectronico</td>
                                <td>@(u.TB_Rol != null ? u.TB_Rol.NombreRol : "Sin rol")</td>
                                <td>@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (u.Estado)
                                    {
                                        <span class="badge text-bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">

                              
                                        <a href="@Url.Action("Editar", "Usuario", new { id = u.IdUsuario })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                

                                    @if (u.Estado)
                                    {
                                        if (u.IdUsuario == idActual)
                                        {
                                            <span class="text-muted small">Tu usuario</span>
                                        }
                                        else
                                        {
                                            <form action="@Url.Action("Desactivar", "Usuario")" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.IdUsuario" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-person-x"></i> Desactivar
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <form action="@Url.Action("Reactivar", "Usuario")" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.IdUsuario" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-person-check"></i> Reactivar
                                            </button>
                                        </form>
                                    }

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer text-muted small">
                Total: @Model.Count() usuario(s)
            </div>
        </div>

    </div>
</div>