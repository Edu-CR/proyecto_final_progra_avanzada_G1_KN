@using ProyectoFinalBioquimia_G1.EF
@model TB_Prototipo
@{
    ViewData["Title"] = "Detalle del prototipo";

    string estadoActual = Model.TB_EstadoPrototipo != null ? Model.TB_EstadoPrototipo.NombreEstado : "";

    // Obtener la lista de fórmulas directamente de la navegación de EF
    var formulaList = Model.TB_PrototipoIngrediente != null
        ? Model.TB_PrototipoIngrediente.OrderByDescending(f => f.Porcentaje).ToList()
        : new List<TB_PrototipoIngrediente>();

    decimal sumaFormula = formulaList.Sum(f => f.Porcentaje);

    // Obtener el historial ordenado por fecha de cambio
    var historialList = Model.TB_HistorialEstado != null
        ? Model.TB_HistorialEstado.OrderBy(h => h.FechaCambio).ToList()
        : new List<TB_HistorialEstado>();

    // Obtener las empresas asociadas a través de la relación de EF
    var empresasList = Model.TB_Empresa != null
        ? Model.TB_Empresa.OrderBy(e => e.NombreEmpresa).Select(e => e.NombreEmpresa).ToList()
        : new List<string>();

    string ObtenerClaseEstado(string estado)
    {
        switch (estado)
        {
            case "En trámite": return "bg-warning text-dark";
            case "Aprobado": return "bg-success";
            case "Devuelto": return "bg-danger";
            case "En pruebas": return "bg-info text-dark";
            default: return "bg-secondary";
        }
    }
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-8">
                <h3 class="mb-0">
                    @Model.NombrePrototipo
                    <span class="badge @ObtenerClaseEstado(estadoActual) fs-6 align-middle">@estadoActual</span>
                </h3>
            </div>
            <div class="col-sm-4 text-sm-end mt-2 mt-sm-0">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al histórico
                </a>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        @if (!string.IsNullOrEmpty(Model.ComentarioGerente))
        {
            <div class="alert @(estadoActual == "Devuelto" ? "alert-warning" : "alert-secondary")" role="alert">
                <strong>Comentario del gerente:</strong> @Model.ComentarioGerente
            </div>
        }

        <div class="row">
            <div class="col-lg-8 mb-3">
                <div class="card h-100">
                    <div class="card-header"><strong>Información general</strong></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Categoría</dt>
                            <dd class="col-sm-8">@(Model.TB_Categoria != null ? Model.TB_Categoria.NombreCategoria : "—")</dd>
                            <dt class="col-sm-4">Químico</dt>
                            <dd class="col-sm-8">@(Model.TB_Usuario != null ? Model.TB_Usuario.NombreCompleto : "—")</dd>
                            <dt class="col-sm-4">Descripción</dt>
                            <dd class="col-sm-8">@Model.Descripcion</dd>
                            <dt class="col-sm-4">Envase</dt>
                            <dd class="col-sm-8">@Model.CaracteristicasEnvase</dd>
                            <dt class="col-sm-4">Creado</dt>
                            <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                            <dt class="col-sm-4">Última actualización</dt>
                            <dd class="col-sm-8">@(Model.FechaModificacion.HasValue ? Model.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm") : "—")</dd>
                            <dt class="col-sm-4">Empresas</dt>
                            <dd class="col-sm-8 mb-0">
                                @(empresasList.Any() ? string.Join(", ", empresasList) : "Sin empresas relacionadas")
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-3">
                <div class="card h-100">
                    <div class="card-header"><strong>Imagen</strong></div>
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(Model.ImagenRuta))
                        {
                            <img src="@Url.Content(Model.ImagenRuta)" alt="Imagen de @Model.NombrePrototipo"
                                 class="img-fluid rounded" style="max-height: 260px;" />
                        }
                        else
                        {
                            <p class="text-secondary mb-0">Sin imagen</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>Fórmula</strong></div>
            <div class="card-body p-0">
                @if (!formulaList.Any())
                {
                    <p class="text-secondary m-3">El prototipo no tiene ingredientes registrados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Ingrediente</th>
                                    <th>Función</th>
                                    <th>Unidad base</th>
                                    <th class="text-end">Porcentaje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in formulaList)
                                {
                                    <tr>
                                        <td>@(f.TB_Ingrediente != null ? f.TB_Ingrediente.NombreIngrediente : "—")</td>
                                        <td>@(f.TB_Ingrediente != null ? f.TB_Ingrediente.Funcion : "—")</td>
                                        <td>@(f.TB_Ingrediente != null ? f.TB_Ingrediente.UnidadBase : "—")</td>
                                        <td class="text-end">@f.Porcentaje.ToString("0.00") %</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3">Total</th>
                                    <th class="text-end @(sumaFormula == 100m ? "text-success" : "text-danger")">@sumaFormula.ToString("0.00") %</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header"><strong>Historial de estados</strong></div>
            <div class="card-body p-0">
                @if (!historialList.Any())
                {
                    <p class="text-secondary m-3">No hay cambios de estado registrados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Cambio</th>
                                    <th>Usuario</th>
                                    <th>Justificación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in historialList)
                                {
                                    string estadoAnterior = h.TB_EstadoPrototipo != null ? h.TB_EstadoPrototipo.NombreEstado : null;
                                    string estadoNuevo = h.TB_EstadoPrototipo1 != null ? h.TB_EstadoPrototipo1.NombreEstado : "";

                                    <tr>
                                        <td class="text-nowrap">@h.FechaCambio.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-nowrap">
                                            @if (string.IsNullOrEmpty(estadoAnterior))
                                            {
                                                <span>Creado como</span>
                                            }
                                            else
                                            {
                                                <span class="badge @ObtenerClaseEstado(estadoAnterior)">@estadoAnterior</span>
                                                <i class="bi bi-arrow-right"></i>
                                            }
                                            <span class="badge @ObtenerClaseEstado(estadoNuevo)">@estadoNuevo</span>
                                        </td>
                                        <td>@(h.TB_Usuario != null ? h.TB_Usuario.NombreCompleto : "—")</td>
                                        <td>@(string.IsNullOrEmpty(h.Justificacion) ? "—" : h.Justificacion)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>