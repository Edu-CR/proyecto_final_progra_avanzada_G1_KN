@using ProyectoFinalBioquimia_G1.Models
@model List<PrototipoListaModel>
@{
    ViewData["Title"] = "Histórico de prototipos";
    var filtro = ViewBag.Filtro as HistoricoFiltroModel ?? new HistoricoFiltroModel();
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Histórico de prototipos</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
        }
        @if (ViewBag.Advertencia != null)
        {
            <div class="alert alert-warning" role="alert">@ViewBag.Advertencia</div>
        }

        <div class="card mb-3">
            <div class="card-body">
                @using (Html.BeginForm("Index", "Historico", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
                {
                    <div class="col-lg-4 col-md-6">
                        <label for="Buscar" class="form-label">Buscar</label>
                        <input type="text" id="Buscar" name="Buscar" class="form-control"
                               placeholder="Nombre o descripción" value="@filtro.Buscar" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="IdEstado" class="form-label">Estado</label>
                        @Html.DropDownList("IdEstado", (SelectList)ViewBag.Estados, "Todos", new { @class = "form-select" })
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label for="IdCategoria" class="form-label">Categoría</label>
                        @Html.DropDownList("IdCategoria", (SelectList)ViewBag.Categorias, "Todas", new { @class = "form-select" })
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label for="IdQuimico" class="form-label">Químico</label>
                        @Html.DropDownList("IdQuimico", (SelectList)ViewBag.Quimicos, "Todos", new { @class = "form-select" })
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label for="Desde" class="form-label">Creado desde</label>
                        <input type="date" id="Desde" name="Desde" class="form-control"
                               value="@(filtro.Desde.HasValue ? filtro.Desde.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label for="Hasta" class="form-label">Creado hasta</label>
                        <input type="date" id="Hasta" name="Hasta" class="form-control"
                               value="@(filtro.Hasta.HasValue ? filtro.Hasta.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel"></i> Filtrar
                        </button>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">Limpiar filtros</a>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="text-secondary">@(Model == null ? 0 : Model.Count) prototipo(s) encontrados</span>
            </div>
            <div class="card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <p class="text-secondary m-3">No hay prototipos que coincidan con los filtros.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Prototipo</th>
                                    <th>Categoría</th>
                                    <th>Químico</th>
                                    <th>Estado</th>
                                    <th>Creación</th>
                                    <th>Última actualización</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.NombrePrototipo</td>
                                        <td>@item.Categoria</td>
                                        <td>@item.Quimico</td>
                                        <td><span class="badge @PrototipoListaModel.ClaseEstado(item.Estado)">@item.Estado</span></td>
                                        <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                        <td>@item.UltimaActualizacion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <a href="@Url.Action("Detalle", new { id = item.IdPrototipo })"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i> Ver detalle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
