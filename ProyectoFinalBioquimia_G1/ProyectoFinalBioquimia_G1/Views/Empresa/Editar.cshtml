@model ProyectoFinalBioquimia_G1.EF.TB_Empresa

@{
    ViewBag.Title = "Editar empresa";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Editar empresa</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
        }

        @if (!Model.Estado)
        {
            <div class="alert alert-warning" role="alert">
                Esta empresa está inactiva y no aparece al relacionar prototipos con empresas.
            </div>
        }

        <div class="card" style="max-width: 760px;">
            <div class="card-body">
                @using (Html.BeginForm("Editar", "Empresa", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    @Html.Partial("_FormularioEmpresa", Model)

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar cambios
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                }
            </div>
        </div>

    </div>
</div>