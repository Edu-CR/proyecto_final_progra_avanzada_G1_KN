@model ProyectoFinalBioquimia_G1.EF.TB_Prototipo

@using System
@using System.Collections.Generic
@using System.Linq
@using ProyectoFinalBioquimia_G1.EF

@{
    var accion = Convert.ToString(ViewContext.RouteData.Values["action"]);
    bool esEdicion = accion == "Editar";

    var categorias = ViewBag.Categorias as SelectList;
    var ingredientes = ViewBag.Ingredientes as IEnumerable<TB_Ingrediente>;
    var ingredientesActuales =
        ViewBag.IngredientesActuales as IEnumerable<TB_PrototipoIngrediente>
        ?? new List<TB_PrototipoIngrediente>();

    var filas = ingredientesActuales.ToList();

    if (!filas.Any())
    {
        filas.Add(new TB_PrototipoIngrediente());
    }
}

<div class="prototipo-formulario col-12 col-xl-9 mb-5">

    @using (Html.BeginForm(
        accion,
        "Prototipo",
        FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        if (esEdicion)
        {
            @Html.HiddenFor(m => m.IdPrototipo)
        }
        @* TO DO para la entrega final: Revisar el cuadro de alerta roja que aparece vacio al ingresar
            a la vista de creación de prototipos. Investigar su origen y corregir
            su comportamiento para la entrega final. *@
        @Html.ValidationSummary(
            false,
            "",
            new { @class = "alert alert-danger" })

        <div class="mb-3">
            @Html.LabelFor(m => m.NombrePrototipo, "Nombre del prototipo", new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(
                m => m.NombrePrototipo,
                new
                {
                    @class = "form-control",
                    maxlength = "150",
                    placeholder = "Nombre del prototipo"
                })
            @Html.ValidationMessageFor(
                m => m.NombrePrototipo,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.IdCategoria, "Categoría", new { @class = "form-label fw-semibold" })

            @Html.DropDownListFor(
                m => m.IdCategoria,
                categorias,
                "-- Selecciona una categoría --",
                new { @class = "form-select" })

            @Html.ValidationMessageFor(
                m => m.IdCategoria,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Descripcion, "Descripción", new { @class = "form-label fw-semibold" })

            @Html.TextAreaFor(
                m => m.Descripcion,
                new
                {
                    @class = "form-control",
                    rows = "4",
                    placeholder = "Describe el propósito y las características del prototipo."
                })

            @Html.ValidationMessageFor(
                m => m.Descripcion,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.CaracteristicasEnvase, "Características del envase", new { @class = "form-label fw-semibold" })

            @Html.TextAreaFor(
                m => m.CaracteristicasEnvase,
                new
                {
                    @class = "form-control",
                    rows = "3",
                    placeholder = "Indica el tipo de envase, material, capacidad y otras características."
                })

            @Html.ValidationMessageFor(
                m => m.CaracteristicasEnvase,
                "",
                new { @class = "text-danger" })
        </div>

        <hr />

        <h4>Ingredientes y porcentajes</h4>
        <p class="text-muted">
            Agrega los ingredientes que componen el prototipo.
            La suma de sus porcentajes debe ser exactamente 100%.
        </p>

        <div id="contenedorIngredientes">

            @foreach (var fila in filas)
            {
                <div class="ingrediente-fila d-flex flex-column flex-md-row gap-3 align-items-md-end mb-3 p-3 border rounded">
                    <div class="campo-ingrediente flex-grow-1">
                        <label class="form-label fw-semibold">Ingrediente</label>

                        <select name="idsIngredientes"
                                class="form-select selector-ingrediente"
                                required>
                            <option value="">-- Selecciona un ingrediente --</option>

                            @if (ingredientes != null)
                            {
                                foreach (var ingrediente in ingredientes)
                                {
                                    if (fila.IdIngrediente == ingrediente.IdIngrediente)
                                    {
                                        <option value="@ingrediente.IdIngrediente" selected="selected">
                                            @ingrediente.NombreIngrediente
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@ingrediente.IdIngrediente">
                                            @ingrediente.NombreIngrediente
                                        </option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="campo-porcentaje col-md-3">
                        <label class="form-label fw-semibold">Porcentaje (%)</label>

                        <input type="number"
                               name="porcentajes"
                               class="form-control porcentaje-ingrediente"
                               min="0.01"
                               max="100"
                               step="0.01"
                               value="@(fila.Porcentaje > 0 ? fila.Porcentaje.ToString("0.##") : "")"
                               placeholder="Ej. 25"
                               required />
                    </div>

                    <div class="campo-accion">
                        <button type="button"
                                class="btn btn-outline-danger quitar-ingrediente">
                            Quitar
                        </button>
                    </div>
                </div>
            }

        </div>

        <button type="button"
                id="agregarIngrediente"
                class="btn btn-outline-primary">
            + Agregar ingrediente
        </button>

        <div class="total-porcentaje fw-bold mt-2">
            Total: <span id="totalPorcentaje">0.00</span>%
            <span id="estadoPorcentaje" class="text-muted">
                (Debe sumar 100%)
            </span>
        </div>

        <hr />

        <div class="mb-3">
            <label for="imagen" class="form-label fw-semibold">Fotografía del prototipo</label>

            @if (esEdicion && !string.IsNullOrWhiteSpace(Model.ImagenRuta))
            {
                <p>Imagen actual:</p>
                <img src="@Url.Content(Model.ImagenRuta)"
                     alt="Imagen actual del prototipo"
                     class="imagen-actual img-thumbnail d-block my-2 w-25" />
                <p class="text-muted">
                    Si no seleccionas otra imagen, se conservará la actual.
                </p>
            }

            <input type="file"
                   id="imagen"
                   name="imagen"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp"
                   @(esEdicion ? "" : "required") />

            <small class="form-text text-muted">
                Formatos permitidos: JPG, JPEG, PNG y WEBP. Tamaño máximo: 5 MB.
            </small>
        </div>

        <hr />

        <button type="submit" class="btn btn-primary">
            @(esEdicion ? "Guardar cambios" : "Guardar como borrador")
        </button>

        @Html.ActionLink(
            "Cancelar",
            "Index",
            "Prototipo",
            null,
            new { @class = "btn btn-secondary" })
    }
</div>

<script src="@Url.Content("~/assets/js/prototipo/crearPrototipo.js")"></script>