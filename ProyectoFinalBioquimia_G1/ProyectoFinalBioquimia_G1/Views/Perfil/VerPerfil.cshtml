@{
    ViewBag.Title = "Mi perfil";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Mi perfil</h3>
            </div>
            
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row">

            <!-- Tarjeta lateral -->
            <div class="col-md-4">
                <div class="card card-primary card-outline">
                    <div class="card-body text-center">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 90px; height: 90px; font-size: 2.5rem;">
                            @(((string)ViewBag.NombreCompleto).Substring(0, 1).ToUpper())
                        </div>

                        <h4 class="mb-1">@ViewBag.NombreCompleto</h4>
                        <p class="text-muted mb-2">@ViewBag.CorreoElectronico</p>

                        <span class="badge text-bg-success">
                            <i class="bi bi-check-circle"></i> Activo
                        </span>
                    </div>
                </div>
            </div>

            <!-- Datos del usuario -->
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-person-badge me-1"></i> Información personal
                        </h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Identificación</dt>
                            <dd class="col-sm-8">@ViewBag.Identificacion</dd>

                            <dt class="col-sm-4">Nombre completo</dt>
                            <dd class="col-sm-8">@ViewBag.NombreCompleto</dd>

                            <dt class="col-sm-4">Correo electrónico</dt>
                            <dd class="col-sm-8">@ViewBag.CorreoElectronico</dd>

                            <dt class="col-sm-4">Rol</dt>
                            <dd class="col-sm-8">@ViewBag.NombreRol</dd>

                            <dt class="col-sm-4">Miembro desde</dt>
                            <dd class="col-sm-8">@(((DateTime)ViewBag.FechaCreacion).ToString("dd/MM/yyyy"))</dd>
                        </dl>
                    </div>
                </div>

                <!-- Seguridad -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-shield-lock me-1"></i> Seguridad
                        </h5>
                    </div>
                    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <strong>Contraseña</strong>
                            <p class="text-muted mb-0">¿Quieres actualizar tu contraseña de acceso? Haga click en el boton y siga los pasos</p>
                        </div>
                        <a href="@Url.Action("Recuperar", "Auth")" class="btn btn-primary">
                            <i class="bi bi-key"></i> Cambiar contraseña
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>