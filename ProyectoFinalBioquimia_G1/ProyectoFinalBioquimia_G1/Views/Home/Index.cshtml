                                    <td class="text-center">Walmart</td>
                                    <td class="text-center"><span class="badge text-bg-success">Aprobado</span></td>
                                    <td class="text-center">20/09/2026</td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center"><img src="~/assets/img/prototipos/abrillantador.jpg" width="135" class="rounded shadow-sm" /></td>
                                    <td class="text-center"><strong>Abrillantador para Muebles</strong></td>
                                    <td class="text-center">Santa Ceci Market</td>
                                    <td class="text-center"><span class="badge text-bg-warning">En Revisión</span></td>
                                    <td class="text-center">22/09/2026</td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center"><img src="~/assets/img/prototipos/desengrasante.jpg" width="135" class="rounded shadow-sm" /></td>
                                    <td class="text-center"><strong>Desengrasante Tsunami</strong></td>
                                    <td class="text-center">Walmart</td>
                                    <td class="text-center"><span class="badge text-bg-success">Aprobado</span></td>
                                    <td class="text-center">18/09/2026</td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center"><img src="~/assets/img/prototipos/detergente.jpg" width="135" class="rounded shadow-sm" /></td>
                                    <td class="text-center"><strong>Detergente Líquido</strong></td>
                                    <td class="text-center">Auto Mercado</td>
                                    <td class="text-center"><span class="badge text-bg-warning">En Revisión</span></td>
                                    <td class="text-center">24/09/2026</td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center"><img src="~/assets/img/prototipos/lavaplatos.jpg" width="135" class="rounded shadow-sm" /></td>
                                    <td class="text-center"><strong>Lavaplatos Tsunami</strong></td>
                                    <td class="text-center">Walmart</td>
                                    <td class="text-center"><span class="badge text-bg-success">Aprobado</span></td>
                                    <td class="text-center">15/09/2026</td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>