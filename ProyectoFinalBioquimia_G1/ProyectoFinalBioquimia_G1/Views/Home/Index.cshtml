@{
    ViewData["Title"] = "Inicio";
}

<!-- INICIO SECCIONES DE DEBUG, LUEGO LAS QUITAMOS -->
<!-- DEBUG: GERENTE (azul) -->
<div class="card border-primary m-3 shadow-sm">
    <div class="card-header bg-primary text-white fw-bold">
        <i class="bi bi-bug-fill me-2"></i> [DEBUG] Vistas exclusivas de GERENTE
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", "Gerente")" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-speedometer2"></i> Dashboard Gerente (Index)
            </a>
            <a href="@Url.Action("Index", "Empresa")" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-building"></i> Empresa (Index)
            </a>
            <a href="@Url.Action("Crear", "Empresa")" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-plus-circle"></i> Empresa (Crear)
            </a>
            
            <a href="@Url.Action("Index", "Usuario")" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-people"></i> Usuarios (Index)
            </a>
            <a href="@Url.Action("Crear", "Usuario")" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-person-plus"></i> Usuarios (Crear)
            </a>
        </div>
    </div>
</div>

<!-- DEBUG: MIXTO (verde) - vistas compartidas por GERENTE Y QUIMICO -->
<div class="card border-success m-3 shadow-sm">
    <div class="card-header bg-success text-white fw-bold">
        <i class="bi bi-bug-fill me-2"></i> [DEBUG] Vistas MIXTAS (GERENTE y QUÍMICO)
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", "Historico")" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-clock-history"></i> Histórico (Index)
            </a>
            <a href="@Url.Action("Index", "Ingrediente")" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-basket"></i> Ingrediente (Index)
            </a>
        </div>
    </div>
</div>

<!-- DEBUG: QUIMICO (celeste) -->
<div class="card border-info m-3 shadow-sm">
    <div class="card-header bg-info text-dark fw-bold">
        <i class="bi bi-bug-fill me-2"></i> [DEBUG] Vistas exclusivas de QUÍMICO
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Crear", "Ingrediente")" class="btn btn-info btn-sm shadow-sm">
                <i class="bi bi-plus-circle"></i> Ingrediente (Crear)
            </a>

            <a href="@Url.Action("Index", "Tramite")" class="btn btn-info btn-sm shadow-sm">
                <i class="bi bi-file-earmark-text"></i> Trámite (Index)
            </a>
            <a href="@Url.Action("Index", "Prototipo")" class="btn btn-info btn-sm shadow-sm">
                <i class="bi bi-flask"></i> Prototipos (Index)
            </a>
            <a href="@Url.Action("Crear", "Prototipo")" class="btn btn-info btn-sm shadow-sm">
                <i class="bi bi-plus-circle"></i> Prototipos (Crear)
            </a>
        </div>
    </div>
</div>

<!-- FIN DE SECCIONES DE DEBUG -->

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">
                    Bienvenido de vuelta,
                    @(Session["NombreUsuarioSession"] != null ? Session["NombreUsuarioSession"].ToString() : "Usuario invitado")!
                </h3>
            </div>
        </div>
    </div>
</div>
