@{
    ViewData["Title"] = "Inicio";
}

<!-- INICIO SECCIÓN DE DEBUG, LUEGO AHI LA QUITAMOS -->
<div class="card bg-warning-subtle border-warning m-3 shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-bug-fill me-2"></i> [MENÚ DE DEBUG DE RUTAS] Acceso Rápido a Vistas para testeo de roles y demás
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
       
            <a href="@Url.Action("Index", "Empresa")" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-building"></i> Empresa (Index)
            </a>
            <a href="@Url.Action("Crear", "Empresa")" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-plus-circle"></i> Empresa (Crear)
            </a>
            <a href="@Url.Action("Editar", "Empresa", new { id = 1 })" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-pencil-square"></i> Empresa (Editar)
            </a>

            
            <a href="@Url.Action("Index", "Ingrediente")" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-basket"></i> Ingrediente (Index)
            </a>
            <a href="@Url.Action("Crear", "Ingrediente")" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-plus-circle"></i> Ingrediente (Crear)
            </a>
            <a href="@Url.Action("Editar", "Ingrediente", new { id = 1 })" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-pencil-square"></i> Ingrediente (Editar)
            </a>

            <a href="@Url.Action("Index", "Historico")" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-clock-history"></i> Histórico (Index)
            </a>
            <a href="@Url.Action("Detalle", "Historico", new { id = 1 })" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-journal-text"></i> Histórico (Detalle)
            </a>

       
            <a href="@Url.Action("Index", "Tramite")" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-file-earmark-text"></i> Trámite (Index)
            </a>


            <a href="@Url.Action("Login", "Auth")" class="btn btn-warning btn-sm shadow-sm">
                <i class="bi bi-box-arrow-in-right"></i> Auth (Login)
            </a>
        </div>
    </div>
</div>
<!-- FIN DE SECCIÓN DE DEBUG -->

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">
                    Bienvenido de vuelta,
                    @(Session["NombreUsuarioSession"] != null ? Session["NombreUsuarioSession"].ToString() : "Usuario invitado")!
                </h3>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <!-- Tarjetas de resumen -->
        <div class="row mb-4">
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-primary">
                    <div class="inner">
                        <h3>5</h3>
                        <p>Prototipos Activos</p>
                    </div>
                    <i class="bi bi-flask small-box-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-warning">
                    <div class="inner">
                        <h3>2</h3>
                        <p>Pendientes de Aprobación</p>
                    </div>
                    <i class="bi bi-clock-history small-box-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-success">
                    <div class="inner">
                        <h3>3</h3>
                        <p>Aprobados este mes</p>
                    </div>
                    <i class="bi bi-check-circle small-box-icon"></i>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-info">
                    <div class="inner">
                        <h3>12</h3>
                        <p>Usuarios Activos</p>
                    </div>
                    <i class="bi bi-people small-box-icon"></i>
                </div>
            </div>
        </div>

