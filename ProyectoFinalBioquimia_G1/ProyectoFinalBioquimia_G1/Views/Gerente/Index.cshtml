
@model IEnumerable<ProyectoFinalBioquimia_G1.EF.TB_Prototipo>

@{
    ViewBag.Title = "Dashboard del Gerente";

    int pendientes = ViewBag.Pendientes ?? 0;
    int aprobados = ViewBag.Aprobados ?? 0;
    int devueltos = ViewBag.Devueltos ?? 0;
    int cancelados = ViewBag.Cancelados ?? 0;
}

<div class="container-fluid mt-4">

    <h2 class="mb-2">Dashboard del Gerente</h2>
    <p class="text-muted mb-4">
        Panel de evaluación y seguimiento de prototipos.
    </p>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Indicadores -->
    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="card border-warning h-100">
                <div class="card-body">
                    <h6 class="text-muted">Pendientes</h6>
                    <h2 class="text-warning">@pendientes</h2>
                    <small>Esperando evaluación</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-success h-100">
                <div class="card-body">
                    <h6 class="text-muted">Aprobados</h6>
                    <h2 class="text-success">@aprobados</h2>
                    <small>Prototipos aprobados</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-info h-100">
                <div class="card-body">
                    <h6 class="text-muted">Devueltos</h6>
                    <h2 class="text-info">@devueltos</h2>
                    <small>Requieren correcciones</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-danger h-100">
                <div class="card-body">
                    <h6 class="text-muted">Cancelados</h6>
                    <h2 class="text-danger">@cancelados</h2>
                    <small>Prototipos cancelados</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Tabla de prototipos pendientes -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Prototipos pendientes de evaluación</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Prototipo</th>
                            <th>Categoría</th>
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var prototipo in Model)
                            {
                                <tr>
                                    <td>@prototipo.IdPrototipo</td>
                                    <td>@prototipo.NombrePrototipo</td>
                                    <td>
                                        @(prototipo.TB_Categoria != null
                                            ? prototipo.TB_Categoria.NombreCategoria
                                            : "Sin categoría")
                                    </td>
                                    <td>
                                        @prototipo.FechaCreacion.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        <span class="badge badge-warning">
                                            @prototipo.TB_EstadoPrototipo.NombreEstado
                                        </span>
                                    </td>

                                    <td>
                                        <a href="@Url.Action("Detalle", "Gerente",
                                           new { id = prototipo.IdPrototipo })"
                                           class="btn btn-primary btn-sm">
                                            Ver y evaluar
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No hay prototipos pendientes de evaluación.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tabla de todos los prototipos -->
    <div class="card shadow-sm mt-4">

        <div class="card-header">
            <h5 class="mb-0">
                Historial general de prototipos
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Prototipo</th>
                            <th>Categoría</th>
                            <th>Químico responsable</th>
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var todosPrototipos =
                                ViewBag.TodosPrototipos as
                                List<ProyectoFinalBioquimia_G1.EF.TB_Prototipo>;
                        }

                        @if (todosPrototipos != null &&
                             todosPrototipos.Any())
                        {
                            foreach (var prototipo in todosPrototipos)
                            {
                                string estado =
                                    prototipo.TB_EstadoPrototipo.NombreEstado;

                                string colorEstado = "secondary";

                                switch (estado)
                                {
                                    case "Enviado":
                                        colorEstado = "warning";
                                        break;

                                    case "Aprobado":
                                        colorEstado = "success";
                                        break;

                                    case "Devuelto":
                                        colorEstado = "info";
                                        break;

                                    case "Cancelado":
                                        colorEstado = "danger";
                                        break;
                                }

                                <tr>
                                    <td>@prototipo.IdPrototipo</td>

                                    <td>
                                        @prototipo.NombrePrototipo
                                    </td>

                                    <td>
                                        @(prototipo.TB_Categoria != null
                                            ? prototipo.TB_Categoria.NombreCategoria
                                            : "Sin categoría")
                                    </td>

                                    <td>
                                        @(prototipo.TB_Usuario != null
                                            ? prototipo.TB_Usuario.NombreCompleto
                                            : "Sin asignar")
                                    </td>

                                    <td>
                                        @prototipo.FechaCreacion.ToString("dd/MM/yyyy")
                                    </td>


                                    <td>
                                        @{
                                            string fondoEstado = "#6c757d";
                                            string textoEstado = "#ffffff";

                                            switch (estado)
                                            {
                                                case "Borrador":
                                                    fondoEstado = "#6c757d";
                                                    break;

                                                case "Enviado":
                                                    fondoEstado = "#ffc107";
                                                    textoEstado = "#212529";
                                                    break;

                                                case "Aprobado":
                                                    fondoEstado = "#198754";
                                                    break;

                                                case "Devuelto":
                                                    fondoEstado = "#0dcaf0";
                                                    textoEstado = "#212529";
                                                    break;

                                                case "Cancelado":
                                                    fondoEstado = "#dc3545";
                                                    break;
                                            }
                                        }

                                        <span class="badge"
                                              style="background-color:@fondoEstado;
                                                color:@textoEstado;
                                                padding:7px 12px;
                                                border-radius:6px;
                                                font-size:12px;
                                                font-weight:600;">
                                            @estado
                                        </span>
                                    </td>


                                    <td>
                                        <a href="@Url.Action(
                                            "Detalle",
                                            "Gerente",
                                            new { id = prototipo.IdPrototipo })"
                                           class="btn btn-primary btn-sm">
                                            Ver detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted">
                                    No hay prototipos registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
