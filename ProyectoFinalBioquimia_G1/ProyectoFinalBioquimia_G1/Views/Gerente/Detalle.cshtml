
@model ProyectoFinalBioquimia_G1.EF.TB_Prototipo

@{
    ViewBag.Title = "Evaluación de prototipo";

    string estadoActual = Model.TB_EstadoPrototipo.NombreEstado;

    bool puedeEvaluar = estadoActual == "Enviado";

    bool puedeCancelar =
        estadoActual == "Borrador" ||
        estadoActual == "Enviado" ||
        estadoActual == "Devuelto" ||
        estadoActual == "Aprobado";
}

<div class="container-fluid mt-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    <div class="mb-4">
        <a href="@Url.Action("Index", "Gerente")"
           class="btn btn-secondary btn-sm">
            Volver al dashboard
        </a>
    </div>

    <h2>Evaluación de prototipo</h2>
    <p class="text-muted">
        Consulta la información antes de tomar una decisión.
    </p>

    <!-- Información del prototipo -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">@Model.NombrePrototipo</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-8">
                    <p>
                        <strong>ID:</strong>
                        @Model.IdPrototipo
                    </p>

                    <p>
                        <strong>Categoría:</strong>
                        @Model.TB_Categoria.NombreCategoria
                    </p>

                    <p>
                        <strong>Químico responsable:</strong>
                        @Model.TB_Usuario.NombreCompleto
                    </p>

                    <p>
                        <strong>Descripción:</strong>
                        @Model.Descripcion
                    </p>

                    <p>
                        <strong>Características del envase:</strong>
                        @Model.CaracteristicasEnvase
                    </p>

                    <p>
                        <strong>Estado:</strong>
                        <span class="badge badge-info">
                            @estadoActual
                        </span>
                    </p>

                    <p>
                        <strong>Fecha de creación:</strong>
                        @Model.FechaCreacion.ToString("dd/MM/yyyy")
                    </p>
                </div>

                <div class="col-md-4">
                    <h6>Imagen del prototipo</h6>

                    @if (!string.IsNullOrWhiteSpace(Model.ImagenRuta))
                    {
                        <img src="@Url.Content(Model.ImagenRuta)"
                             alt="Imagen del prototipo"
                             class="img-fluid rounded border"
                             style="max-height:250px;" />
                    }
                    else
                    {
                        <p class="text-muted">
                            Sin imagen disponible.
                        </p>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- Fórmula del prototipo -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Fórmula del prototipo</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Ingrediente</th>
                            <th>Función</th>
                            <th>Porcentaje</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var ingrediente in Model.TB_PrototipoIngrediente)
                        {
                            <tr>
                                <td>
                                    @ingrediente.TB_Ingrediente.NombreIngrediente
                                </td>
                                <td>
                                    @ingrediente.TB_Ingrediente.Funcion
                                </td>
                                <td>
                                    @ingrediente.Porcentaje.ToString("0.00") %
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <th colspan="2">Total</th>
                            <th>
                                @Model.TB_PrototipoIngrediente.Sum(
                                         i => i.Porcentaje).ToString("0.00") %
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Decisión del gerente -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Decisión del gerente</h5>
        </div>

        <div class="card-body">

            @if (puedeEvaluar || puedeCancelar)
            {
                <form method="post"
                      action="@Url.Action("Evaluar", "Gerente")">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.IdPrototipo" />

                    <div class="form-group mb-3">
                        <label for="justificacion">
                            <strong>Justificación de la decisión *</strong>
                        </label>

                        <textarea name="justificacion"
                                  id="justificacion"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  required
                                  placeholder="Escribe el motivo de la decisión..."></textarea>

                        <small class="text-muted">
                            La justificación es obligatoria
                            para cualquier decisión.
                        </small>
                    </div>

                    <div class="d-flex flex-wrap"
                         style="gap:10px;">

                        @if (puedeEvaluar)
                        {
                            <button type="submit"
                                    name="decision"
                                    value="Aprobado"
                                    class="btn btn-success">
                                Aprobar prototipo
                            </button>

                            <button type="submit"
                                    name="decision"
                                    value="Devuelto"
                                    class="btn btn-warning">
                                Devolver al químico
                            </button>
                        }

                        @if (puedeCancelar)
                        {
                            <button type="submit"
                                    name="decision"
                                    value="Cancelado"
                                    class="btn btn-danger"
                                    onclick="return confirm('¿Está seguro de que desea cancelar este prototipo?');">
                                Cancelar prototipo
                            </button>
                        }

                    </div>

                </form>
            }
            else
            {
                <div class="alert alert-info">
                    Este prototipo ya fue cancelado y
                    no permite nuevas evaluaciones.
                </div>
            }

        </div>
    </div>

</div>
