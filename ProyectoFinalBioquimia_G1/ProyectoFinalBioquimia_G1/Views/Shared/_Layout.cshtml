@{

    const int ROL_GERENTE = 2;
    const int ROL_QUIMICO = 1;

    int rolActual = 0;
    if (Session["RolUsuarioSession"] != null)
    {
        int.TryParse(Session["RolUsuarioSession"].ToString(), out rolActual);
    }

    bool esGerente = rolActual == ROL_GERENTE;
    bool esQuimico = rolActual == ROL_QUIMICO;
}
<!doctype html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Bioquimia | Sistema de prototipos</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

    <meta name="title" content="Tarea 1 | ProtoQuimi" />
    <meta name="author" content="ColorlibHQ" />
    <meta name="description"
          content="Sistema para los prototipos de Bioquimia." />
    <meta name="keywords"
          content="bootstrap 5, bootstrap, bootstrap 5 admin dashboard, bootstrap 5 dashboard, bootstrap 5 charts, bootstrap 5 calendar, bootstrap 5 datepicker, bootstrap 5 tables, bootstrap 5 datatable, vanilla js datatable, colorlibhq, colorlibhq dashboard, colorlibhq admin dashboard, accessible admin panel" />

    <meta name="supported-color-schemes" content="light dark" />
    <link rel="preload" href="~/assets/css/adminlte.css" as="style" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/&#64;fontsource/source-sans-3&#64;5.0.12/index.css"
          integrity="sha256-tXJfXfp6Ewt1ilPzLDtQnJV4hclT9XuaZUKyUvmyr+Q="
          crossorigin="anonymous"
          media="print" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/overlayscrollbars&#64;2.11.0/styles/overlayscrollbars.min.css"
          crossorigin="anonymous" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons&#64;1.13.1/font/bootstrap-icons.min.css"
          crossorigin="anonymous" />

    <link rel="stylesheet" href="~/assets/css/adminlte.css" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">

  

    <!-- Contenedor Principal (Único) -->
    <div class="app-wrapper">

        <!-- Header -->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>
                            <span>@(Session["NombreUsuarioSession"] ?? "Sin sesión")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a href="@Url.Action("VerPerfil", "Perfil")" class="dropdown-item">
                                    <i class="bi bi-person me-2"></i> Perfil de usuario
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form action="@Url.Action("Logout", "Auth")" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a href="@Url.Action("Index", "Home")" class="brand-link">
                    <img src="~/assets/img/logoBioquimia.png"
                         alt="Logo Bioquimia"
                         class="brand-image opacity-75 shadow"
                         style="max-width: 180px; height: auto;" />
                </a>
            </div>

            

            <div class="sidebar-wrapper">
                <nav class="mt-2" aria-label="Main navigation">
                    <ul class="nav sidebar-menu flex-column"
                        data-lte-toggle="treeview"
                        data-accordion="false"
                        id="navigation">

                        <!-- Inicio (todos los roles) -->
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Home")" class="nav-link">
                                <i class="nav-icon bi bi-house-door"></i>
                                <p>Inicio</p>
                            </a>
                        </li>

                        <!--   GERENTE  -->
                        @if (esGerente)
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Gerente")" class="nav-link">
                                    <i class="nav-icon bi bi-speedometer2"></i>
                                    <p>Dashboard del gerente</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Empresa")" class="nav-link">
                                    <i class="nav-icon bi bi-building"></i>
                                    <p>Empresas</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Crear", "Empresa")" class="nav-link">
                                    <i class="nav-icon bi bi-building-add"></i>
                                    <p>Nueva empresa</p>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Usuario")" class="nav-link">
                                    <i class="nav-icon bi bi-people"></i>
                                    <p>Usuarios del sistema</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Crear", "Usuario")" class="nav-link">
                                    <i class="nav-icon bi bi-person-plus"></i>
                                    <p>Nuevo usuario</p>
                                </a>
                            </li>
                        }

                        <!--GERENTE Y QUÍMICO -->
                        @if (esGerente || esQuimico)
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Historico")" class="nav-link">
                                    <i class="nav-icon bi bi-clock-history"></i>
                                    <p>Histórico</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Ingrediente")" class="nav-link">
                                    <i class="nav-icon bi bi-basket"></i>
                                    <p>Ingredientes</p>
                                </a>
                            </li>
                        }

                        <!-- QUIMICO  -->
                        @if (esQuimico)
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Crear", "Ingrediente")" class="nav-link">
                                    <i class="nav-icon bi bi-plus-circle"></i>
                                    <p>Nuevo ingrediente</p>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Tramite")" class="nav-link">
                                    <i class="nav-icon bi bi-file-earmark-text"></i>
                                    <p>Trámites</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Index", "Prototipo")" class="nav-link">
                                    <i class="nav-icon bi bi-flask"></i>
                                    <p>Prototipos</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="@Url.Action("Crear", "Prototipo")" class="nav-link">
                                    <i class="nav-icon bi bi-journal-plus"></i>
                                    <p>Nuevo prototipo</p>
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main content -->
        <main class="app-main">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">Grupo 1 | KN</div>
            <strong>
                Copyright &copy; 2014-2026&nbsp;
                <a href="#" class="text-decoration-none">Bioquimia S.R.L.</a>
            </strong>
            Todos los derechos reservados.
        </footer>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars&#64;2.11.0/browser/overlayscrollbars.browser.es6.min.js"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/&#64;popperjs/core&#64;2.11.8/dist/umd/popper.min.js"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap&#64;5.3.8/dist/js/bootstrap.min.js"
            crossorigin="anonymous"></script>
</body>
</html>
