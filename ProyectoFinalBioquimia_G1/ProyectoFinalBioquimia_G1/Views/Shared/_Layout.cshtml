<!doctype html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Bioquimia | Sistema de prototipos</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

    <meta name="title" content="Tarea 1 | ProtoQuimi" />
    <meta name="author" content="ColorlibHQ" />
    <meta name="description"
          content="Sistema para los prototipos de Bioquimia." />
    <meta name="keywords"
          content="bootstrap 5, bootstrap, bootstrap 5 admin dashboard, bootstrap 5 dashboard, bootstrap 5 charts, bootstrap 5 calendar, bootstrap 5 datepicker, bootstrap 5 tables, bootstrap 5 datatable, vanilla js datatable, colorlibhq, colorlibhq dashboard, colorlibhq admin dashboard, accessible admin panel" />

    <meta name="supported-color-schemes" content="light dark" />
    <link rel="preload" href="~/assets/css/adminlte.css" as="style" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/&#64;fontsource/source-sans-3&#64;5.0.12/index.css"
          integrity="sha256-tXJfXfp6Ewt1ilPzLDtQnJV4hclT9XuaZUKyUvmyr+Q="
          crossorigin="anonymous"
          media="print" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/overlayscrollbars&#64;2.11.0/styles/overlayscrollbars.min.css"
          crossorigin="anonymous" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons&#64;1.13.1/font/bootstrap-icons.min.css"
          crossorigin="anonymous" />

    <link rel="stylesheet" href="~/assets/css/adminlte.css" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">

    <!-- BARRA DE DEBUG -->
    <div class="bg-dark text-white text-center py-1" style="font-size: 12px;">
        [DEBUG] Id: @(Session["IdUsuarioSession"] ?? "Vacía") |
        Nombre: @(Session["NombreUsuarioSession"] ?? "Vacía") |
        Rol: @(Session["RolUsuarioSession"] ?? "Vacía")
    </div>

    <!-- Contenedor Principal (Único) -->
    <div class="app-wrapper">

        <!-- Header -->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <img src="~/assets/img/user2-160x160.jpg"
                                 class="user-image rounded-circle shadow"
                                 alt="Usuario" />

                            <span class="d-none d-md-inline">
                                @(Session["NombreUsuarioSession"] ?? "Sin sesión")
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                            <li class="user-header text-bg-primary">
                                <img src="~/assets/img/user2-160x160.jpg"
                                     class="rounded-circle shadow"
                                     alt="Usuario" />

                                <p>
                                    @(Session["NombreUsuarioSession"] ?? "Sin sesión")
                                    <small>Rol ID: @(Session["RolUsuarioSession"] ?? "N/A")</small>
                                </p>
                            </li>
                            <li class="user-footer">
                                <a href="#" class="btn btn-outline-secondary">Perfil de usuario</a>
                                <a href="#" class="btn btn-outline-danger float-end">
                                    Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a href="#" class="brand-link">
                    <img src="~/assets/img/logoBioquimia.png"
                         alt="Logo Bioquimia"
                         class="brand-image opacity-75 shadow"
                         style="max-width: 180px; height: auto;" />
                </a>
            </div>

            <div class="sidebar-search" role="search">
                <label for="sidebar-search-input" class="visually-hidden">Filter menu</label>
                <input type="search"
                       id="sidebar-search-input"
                       class="form-control form-control-sm"
                       placeholder="Buscar menú…"
                       autocomplete="off"
                       data-lte-toggle="sidebar-search"
                       data-lte-target="#navigation" />
                <p class="fs-7 text-secondary mt-2 mb-0" data-lte-search-empty role="status" hidden>
                    No matching pages.
                </p>
            </div>

            <div class="sidebar-wrapper">
                <nav class="mt-2" aria-label="Main navigation">
                    <ul class="nav sidebar-menu flex-column"
                        data-lte-toggle="treeview"
                        data-accordion="false"
                        id="navigation">

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-speedometer"></i>
                                <p>Dashboard de inicio</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-pencil-square"></i>
                                <p>Nuevo prototipo</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-envelope"></i>
                                <p>Notificaciones al correo</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-table"></i>
                                <p>Catálogo de prototipos</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-graph-up"></i>
                                <p>Reportería</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon bi bi-people"></i>
                                <p>Usuarios del sistema</p>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main content -->
        <main class="app-main">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">Grupo 1 | KN</div>
            <strong>
                Copyright &copy; 2014-2026&nbsp;
                <a href="#" class="text-decoration-none">Bioquimia S.R.L.</a>
            </strong>
            Todos los derechos reservados.
        </footer>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars&#64;2.11.0/browser/overlayscrollbars.browser.es6.min.js"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/&#64;popperjs/core&#64;2.11.8/dist/umd/popper.min.js"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap&#64;5.3.8/dist/js/bootstrap.min.js"
            crossorigin="anonymous"></script>
</body>
</html>