@model ProyectoFinalBioquimia_G1.EF.TB_Ingrediente
@{
    ViewData["Title"] = "Editar ingrediente";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Editar ingrediente</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
        }

        @if (!Model.Estado)
        {
            <div class="alert alert-warning" role="alert">
                Este ingrediente está inactivo y no aparece en el formulario de prototipos.
            </div>
        }

        <div class="card" style="max-width: 640px;">
            <div class="card-body">
                @using (Html.BeginForm("Editar", "Ingrediente", FormMethod.Post))
                {
                    @Html.Partial("_FormularioIngrediente", Model)

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar cambios
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                }
            </div>
        </div>

    </div>
</div>