@model List<ProyectoFinalBioquimia_G1.EF.TB_Ingrediente>
@{
    ViewData["Title"] = "Catálogo de ingredientes";
    string filtro = ViewBag.Filtro as string ?? "activos";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0">Catálogo de ingredientes</h3>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <a href="@Url.Action("Crear")" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Nuevo ingrediente
                </a>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <div class="card">
            <div class="card-header">
                @using (Html.BeginForm("Index", "Ingrediente", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
                {
                    <div class="col-md-6">
                        <label for="buscar" class="form-label">Buscar</label>
                        <input type="text" id="buscar" name="buscar" class="form-control"
                               placeholder="Nombre o función" value="@ViewBag.Buscar" />
                    </div>
                    <div class="col-md-3">
                        <label for="filtro" class="form-label">Mostrar</label>
                        <select id="filtro" name="filtro" class="form-select">
                            <option value="activos" @(filtro == "activos" ? "selected" : "")>Activos</option>
                            <option value="inactivos" @(filtro == "inactivos" ? "selected" : "")>Inactivos</option>
                            <option value="todos" @(filtro == "todos" ? "selected" : "")>Todos</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-search"></i> Filtrar
                        </button>
                    </div>
                }
            </div>

            <div class="card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <p class="text-secondary m-3">No hay ingredientes para mostrar.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Función</th>
                                    <th>Unidad base</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.NombreIngrediente</td>
                                        <td>@item.Funcion</td>
                                        <td>@item.UnidadBase</td>
                                        <td>
                                            @if (item.Estado)
                                            {
                                                <span class="badge text-bg-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">Inactivo</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a href="@Url.Action("Editar", new { id = item.IdIngrediente })"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Editar
                                            </a>

                                            @if (item.Estado)
                                            {
                                                using (Html.BeginForm("Desactivar", "Ingrediente", new { id = item.IdIngrediente }, FormMethod.Post,
                                                    new { @class = "d-inline", onsubmit = "return confirm('¿Desea desactivar este ingrediente?');" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-slash-circle"></i> Desactivar
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("Activar", "Ingrediente", new { id = item.IdIngrediente }, FormMethod.Post,
                                                    new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-check-circle"></i> Activar
                                                    </button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
