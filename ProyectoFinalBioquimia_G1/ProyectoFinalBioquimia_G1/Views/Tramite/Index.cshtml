@model List<ProyectoFinalBioquimia_G1.EF.TB_Prototipo>
@{
    ViewData["Title"] = "En trámite";
}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-0">Prototipos en trámite</h3>
        @if (ViewBag.NombreQuimico != null)
        {
            <p class="text-secondary mb-0">Químico: @ViewBag.NombreQuimico</p>
        }
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
        }

        <div class="row mb-3">
            <div class="col-md-4 col-12 mb-2">
                <div class="small-box text-bg-secondary">
                    <div class="inner">
                        <h3>@(ViewBag.TotalBorrador ?? 0)</h3>
                        <p>En borrador</p>
                    </div>
                    <i class="bi bi-pencil small-box-icon"></i>
                </div>
            </div>
            <div class="col-md-4 col-12 mb-2">
                <div class="small-box text-bg-primary">
                    <div class="inner">
                        <h3>@(ViewBag.TotalEnviado ?? 0)</h3>
                        <p>Enviados a evaluación</p>
                    </div>
                    <i class="bi bi-send small-box-icon"></i>
                </div>
            </div>
            <div class="col-md-4 col-12 mb-2">
                <div class="small-box text-bg-warning">
                    <div class="inner">
                        <h3>@(ViewBag.TotalDevuelto ?? 0)</h3>
                        <p>Devueltos para corregir</p>
                    </div>
                    <i class="bi bi-arrow-return-left small-box-icon"></i>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                @if (Model == null || !Model.Any())
                {
                    <p class="text-secondary m-3">No tiene prototipos en trámite.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Prototipo</th>
                                    <th>Categoría</th>
                                    <th>Estado</th>
                                    <th>Última actualización</th>
                                    <th>Comentario del gerente</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    string estado = item.TB_EstadoPrototipo.NombreEstado;
                                    DateTime ultima = item.FechaModificacion ?? item.FechaCreacion;
                                    string claseEstado;
                                    switch (estado)
                                    {
                                        case "Borrador": claseEstado = "text-bg-secondary"; break;
                                        case "Enviado": claseEstado = "text-bg-primary"; break;
                                        case "Devuelto": claseEstado = "text-bg-warning"; break;
                                        case "Aprobado": claseEstado = "text-bg-success"; break;
                                        case "Cancelado": claseEstado = "text-bg-danger"; break;
                                        default: claseEstado = "text-bg-light"; break;
                                    }

                                    <tr>
                                        <td>@item.NombrePrototipo</td>
                                        <td>@item.TB_Categoria.NombreCategoria</td>
                                        <td><span class="badge @claseEstado">@estado</span></td>
                                        <td>@ultima.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (estado == "Devuelto" && !string.IsNullOrEmpty(item.ComentarioGerente))
                                            {
                                                <span class="text-warning-emphasis">@item.ComentarioGerente</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">—</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a href="@Url.Action("Detalle", "Historico", new { id = item.IdPrototipo })"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i> Ver
                                            </a>
                                            @* TODO: cuando Persona 2 termine RF-08, agregar el botón "Editar"
                                                para los prototipos en Borrador o Devuelto. *@
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>